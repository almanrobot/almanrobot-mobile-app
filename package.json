{
  "name": "almanrobot",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "npm run check-eslint && npm run check-typescript",
    "lint-fix": "eslint './src/**/*{js,ts,jsx,tsx}' --fix",
    "check-eslint": "eslint './src/**/*{js,ts,jsx,tsx}'",
    "check-typescript": "tsc --noEmit",
    "start": "react-native start",
    "release": "standard-version",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.18.1",
    "@react-native-firebase/app": "^18.8.0",
    "@react-native-firebase/messaging": "^18.8.0",
    "@react-native-masked-view/masked-view": "^0.2.8",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/elements": "^1.3.17",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "@react-navigation/stack": "^6.3.16",
    "axios": "^1.4.0",
    "jwt-decode": "^3.1.2",
    "react": "18.2.0",
    "react-hook-form": "^7.43.9",
    "react-native": "0.72.6",
    "react-native-asset": "^2.1.1",
    "react-native-device-info": "^10.6.0",
    "react-native-gesture-handler": "^2.9.0",
    "react-native-google-mobile-ads": "^12.10.0",
    "react-native-network-info": "^5.2.1",
    "react-native-paper": "^5.5.1",
    "react-native-progress-steps": "^1.3.4",
    "react-native-safe-area-context": "^4.5.0",
    "react-native-screens": "^3.20.0",
    "react-native-svg": "^13.8.0",
    "react-native-text-input-mask": "^3.1.4",
    "react-native-tts": "^4.1.0",
    "react-native-url-polyfill": "^1.3.0",
    "react-native-vector-icons": "^9.2.0",
    "react-native-webview": "^13.2.2",
    "styled-components": "^5.3.9"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@commitlint/cli": "^17.5.0",
    "@commitlint/config-conventional": "^17.4.4",
    "@react-native-community/eslint-config": "^3.2.0",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@tsconfig/react-native": "^2.0.2",
    "@types/react": "^18.0.24",
    "@types/react-native-vector-icons": "^6.4.13",
    "@types/styled-components": "^5.1.26",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "metro-react-native-babel-preset": "0.73.8",
    "prettier": "^2.8.7",
    "reactotron-react-native": "^5.0.3",
    "standard-version": "^9.5.0",
    "typescript": "4.8.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint './src/**/*{js,ts,jsx,tsx}' --fix",
      "prettier --write './src/**/*{js,ts,jsx,tsx}'"
    ]
  }
}
